# Copy to bench/.env to point the bench at a real Consul cluster instead of
# the local one compose starts. The Makefile passes this file to compose;
# bench/.env itself is ignored by git.

# Agent or relay to discover the servers through, with http:// or https://
#CONSUL_ADDR=https://consul.example.net
# ACL token, if reads need one
#CONSUL_TOKEN=
# Datacenter to watch when the agent serves several
#CONSUL_DATACENTER=
# Service meta keys for the team, app and version columns, first present wins
#DERIVE_TEAM=team,owner,owners
#DERIVE_APP=app,application
#DERIVE_VERSION=version

# Load generator (local cluster only): target events per second and size
#RATE=15
#FAMILIES=40
#PODS=6
